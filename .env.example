# Copy to .env for local work. On Vercel, set these in the project settings.
# Do not commit real values. See SETUP.md for which account creates each one.

# --- Required to sign in and share a document ---

# Random string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public site. Use the Vercel preview URL until DNS for share.theatlasimpact.com is live.
NEXTAUTH_URL=https://share.theatlasimpact.com
NEXT_PUBLIC_BASE_URL=https://share.theatlasimpact.com
NEXT_PUBLIC_MARKETING_URL=https://share.theatlasimpact.com
NEXT_PUBLIC_APP_BASE_HOST=share.theatlasimpact.com

# Unlocks email verification, data rooms, and custom link names without Stripe.
SELF_HOSTED=true
NEXT_PUBLIC_SELF_HOSTED=true

# Neon / Vercel Postgres. Names match the Vercel Storage integration.
POSTGRES_PRISMA_URL=
POSTGRES_PRISMA_URL_NON_POOLING=
# Set this to the same value as POSTGRES_PRISMA_URL_NON_POOLING so Prisma does not stop the build.
POSTGRES_PRISMA_SHADOW_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_UPLOAD_TRANSPORT=vercel
# Example shape: <store-id>.public.blob.vercel-storage.com
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_HOST=

# Resend. The from-address domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Atlas Impact Solutions <login@share.theatlasimpact.com>
EMAIL_REPLY_TO=van@theatlasimpact.com

# Random strings. Generate with: openssl rand -base64 32
NEXT_PRIVATE_DOCUMENT_PASSWORD_KEY=
NEXT_PRIVATE_VERIFICATION_SECRET=

# Open PDFs in the browser without Trigger.dev or page-image processing.
# Set both to false later if you want page images and page-by-page heatmaps.
DISABLE_DOCUMENT_PROCESSING=true
NEXT_PUBLIC_DISABLE_DOCUMENT_PROCESSING=true

# --- Optional. Leave blank until you want the feature ---

# Google sign-in. Both must be set or the button stays hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn sign-in. Both must be set or the button stays hidden.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Page-level analytics. The app still runs if these are empty.
TINYBIRD_HOST=https://api.us-east.tinybird.co
TINYBIRD_READ_TOKEN=
TINYBIRD_WRITE_TOKEN=
TINYBIRD_TOKEN=

# Background queues. Not required for uploading and viewing a PDF.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# PDF-to-image processing. Leave empty while DISABLE_DOCUMENT_PROCESSING=true.
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# Passkeys. Leave empty to hide the passkey button.
HANKO_API_KEY=
NEXT_PUBLIC_HANKO_TENANT_ID=

# Only needed if you add extra custom domains from inside the app.
PROJECT_ID_VERCEL=
TEAM_ID_VERCEL=
AUTH_BEARER_TOKEN=

# Bulk tus uploads. Normal Vercel Blob uploads do not need this.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_LOCKER_URL=
UPSTASH_REDIS_REST_LOCKER_TOKEN=

# S3 is an alternative to Vercel Blob. Leave empty when using Blob.
NEXT_PRIVATE_UPLOAD_ENDPOINT=
NEXT_PRIVATE_UPLOAD_REGION=us-east-1
NEXT_PRIVATE_UPLOAD_BUCKET=
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_DOMAIN=
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_ID=
NEXT_PRIVATE_UPLOAD_DISTRIBUTION_KEY_CONTENTS=
